# Leave the SF_* values blank to use the built-in mock Salesforce org.
# For a real org: create a Connected App with the OAuth client-credentials flow enabled
# and a "Run As" integration user, then fill these in.
SF_DOMAIN_URL=https://your-domain.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=61.0

# docker compose sets this for you. For local runs without Postgres, SQLite is used.
# DATABASE_URL=postgresql://onboarding:onboarding@localhost:5432/onboarding
